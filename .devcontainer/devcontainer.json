{
  "name": "PETAL breakout exercise",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "workbench.editorAssociations": {
          "README.md": "vscode.markdown.preview.editor"
        }
      }
    },
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    }
  }
}
